*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================
# PROJECT SPECIFIC
# ============================================
# Your specific directories that shouldn't be tracked
ProBiz_*/
*.old/
*_backup/
*_bak/

# Conflict files (like you have in AnimalSoundsMatch)
*conflict*

# Test files
test/
tests/
*.test.js
*.spec.js

# Documentation builds
docs/_build/
site/

